<Window x:Class="DADA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DADA - The Ultimate Shutdown Button" Height="450" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF9F9F9">
        <Button x:Name="DadaButton"
                Width="250" Height="250"
                Content="DADA"
                FontSize="48"
                FontWeight="Bold"
                Foreground="White"
                Cursor="Hand"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Click="DadaButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="ellipse" Fill="Red"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ellipse" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ellipse" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#88000000"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ellipse" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#FFB22222"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock Text="Click the big red button to shutdown immediately."
                   FontSize="16"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,32"
                   TextAlignment="Center"/>
    </Grid>
</Window>
